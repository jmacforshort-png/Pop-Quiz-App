generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  student
}

enum QuizStatus {
  draft
  published
}

enum ResultStatus {
  hidden
  published
}

enum AttemptStatus {
  submitted
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  usernameNormalized String   @unique
  passwordHash       String
  role               UserRole @default(student)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  classId            String?

  class        Class?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  ownedClasses Class[]    @relation("AdminClasses")
  ownedQuizzes Quiz[]     @relation("AdminQuizzes")
  attempts     Attempt[]
  auditLogs    AuditLog[]
  templates    QuizTemplate[] @relation("AdminQuizTemplates")
}

model Class {
  id          String   @id @default(cuid())
  adminId     String
  name        String
  blockNumber Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin       User                  @relation("AdminClasses", fields: [adminId], references: [id], onDelete: Cascade)
  students    User[]
  assignments QuizClassAssignment[]

  @@unique([adminId, blockNumber])
}

model Quiz {
  id                 String       @id @default(cuid())
  adminId            String
  title              String
  description        String?
  status             QuizStatus   @default(draft)
  resultStatus       ResultStatus @default(hidden)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  publishedAt        DateTime?
  resultsPublishedAt DateTime?

  admin       User                  @relation("AdminQuizzes", fields: [adminId], references: [id], onDelete: Cascade)
  questions   Question[]
  assignments QuizClassAssignment[]
  attempts    Attempt[]
  auditLogs   AuditLog[]
}

model Question {
  id         String @id @default(cuid())
  quizId     String
  orderIndex Int
  prompt     String

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices Choice[]
  answers AttemptAnswer[]

  @@unique([quizId, orderIndex])
}

model Choice {
  id         String  @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
}

model QuizClassAssignment {
  id              String   @id @default(cuid())
  quizId          String
  classId         String
  visibleFromUtc  DateTime
  visibleUntilUtc DateTime

  quiz  Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([quizId, classId])
}

model Attempt {
  id          String        @id @default(cuid())
  quizId      String
  studentId   String
  submittedAt DateTime
  score       Int
  maxScore    Int           @default(5)
  status      AttemptStatus @default(submitted)
  createdAt   DateTime      @default(now())

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@unique([quizId, studentId])
}

model AttemptAnswer {
  id            String  @id @default(cuid())
  attemptId     String
  questionId    String
  selectedLabel String
  isCorrect     Boolean

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  quizId      String?
  action      String
  targetType  String
  targetId    String
  createdAt   DateTime @default(now())

  actor User  @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  quiz  Quiz? @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model QuizTemplate {
  id          String   @id @default(cuid())
  adminId     String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin     User               @relation("AdminQuizTemplates", fields: [adminId], references: [id], onDelete: Cascade)
  questions TemplateQuestion[]
}

model TemplateQuestion {
  id         String @id @default(cuid())
  templateId String
  orderIndex Int
  prompt     String

  template QuizTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  choices  TemplateChoice[]

  @@unique([templateId, orderIndex])
}

model TemplateChoice {
  id         String  @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean

  question TemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
}
