  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prisma": "^6.19.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
