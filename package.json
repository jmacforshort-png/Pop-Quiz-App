{
  "name": "pop-quiz",
  "version": "1.0.0",
  "description": "A lightweight browser quiz app built with plain HTML, CSS, and JavaScript.",
  "main": "app.js",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "run-s lint test format:check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
